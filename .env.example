# ---------- Server ----------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/smart-cab-dispatch

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# ---------- CORS (comma separated, no trailing slash) ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Routing ----------
ROUTING_PROVIDER=osrm                 # osrm | ors | haversine
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_MAX_MATRIX_CELLS=9000            # stay under the 10k demo cap
ORS_API_KEY=
ROUTING_TIMEOUT_MS=6000
ROUTING_CACHE_TTL_SEC=900
HAVERSINE_ROAD_FACTOR=1.35
HAVERSINE_AVG_SPEED_KMPH=32

# ---------- Dispatch tuning (also overridable in EventConfig) ----------
DISPATCH_TICK_CRON=*/30 * * * * *     # every 30 seconds
REOPTIMIZE_CRON=0 */2 * * * *         # every 2 minutes
STARVATION_SWEEP_CRON=0 * * * * *     # every minute
BATCH_HORIZON_MIN=45
MAX_DETOUR_MIN=8
STARVATION_THRESHOLD_MIN=20
DRIVER_BREAK_AFTER_TRIPS=4
DRIVER_BREAK_MINUTES=20
DRIVER_MAX_CONTINUOUS_MIN=180

# ---------- Realtime ----------
LOCATION_EMIT_THROTTLE_MS=5000
LOCATION_PERSIST_THROTTLE_MS=15000

# ---------- Web Push (generate with: npx web-push generate-vapid-keys) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------- AI (optional; feature disables itself if blank) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
AI_DAILY_CALL_BUDGET=150

# ---------- Ops ----------
KEEPALIVE_URL=
LOG_LEVEL=info
