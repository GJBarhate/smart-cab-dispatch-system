{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "predev": "node ../../scripts/sync-shared.mjs",
    "dev": "node --watch src/index.js",
    "prebuild": "node ../../scripts/sync-shared.mjs",
    "build": "echo \"server: no build step needed (plain JS)\"",
    "start": "node src/index.js",
    "seed": "node src/seed/seed.js",
    "seed:fresh": "node src/seed/seed.js --fresh",
    "simulate": "node src/sim/simulate.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "4.19.2",
    "mongoose": "8.5.1",
    "socket.io": "4.7.5",
    "jsonwebtoken": "9.0.2",
    "bcryptjs": "2.4.3",
    "zod": "3.23.8",
    "lru-cache": "10.4.3",
    "ngeohash": "0.6.3",
    "munkres-js": "1.2.2",
    "node-cron": "3.0.3",
    "pino": "9.3.2",
    "pino-pretty": "11.2.2",
    "helmet": "7.1.0",
    "cors": "2.8.5",
    "express-rate-limit": "7.4.0",
    "@google/generative-ai": "0.21.0",
    "web-push": "3.6.7",
    "multer": "1.4.5-lts.1",
    "csv-parse": "5.5.6",
    "dotenv": "16.4.5",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "vitest": "2.0.5",
    "supertest": "7.0.0",
    "mongodb-memory-server": "10.0.0",
    "socket.io-client": "4.7.5"
  }
}
