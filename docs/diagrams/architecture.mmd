        Sweep["Starvation sweep<br/>(1 min cron)"]
        Routing["RoutingService<br/>OSRM -> ORS -> haversine"]
        Cache["DistanceCache<br/>L1 LRU + L2 Mongo (geohash)"]
    end

    subgraph Data
        Mongo[("MongoDB Atlas<br/>Driver/Guest/Trip/QueueEntry/...")]
    end

    subgraph External
        OSRM["OSRM public demo"]
        ORS["OpenRouteService"]
        Gemini["Gemini (optional)"]
    end

